# Copy to .env and fill in. Never commit .env.
# Without ORS_API_KEY the app runs in demo mode with generated routes and weather.
ORS_API_KEY=
# Optional: second traffic source (Google Routes API, needs a billing account + budget limit)
GOOGLE_API_KEY=
# Optional: EVIS.AT access once granted (provider is not connected yet)
EVIS_API_KEY=
